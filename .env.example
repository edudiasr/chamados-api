# copie para .env e ajuste se precisar (as portas batem com o docker-compose.yml)
DATABASE_URL=postgres://chamados:chamados@localhost:5434/chamados
REDIS_URL=redis://localhost:6380
# pelo menos 32 caracteres. Para gerar um: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=troque-isto-por-um-segredo-de-verdade-com-32-caracteres
PORT=3000
# true faz a API aplicar as migrations pendentes ao subir (usado no Docker)
RODAR_MIGRATIONS=false
